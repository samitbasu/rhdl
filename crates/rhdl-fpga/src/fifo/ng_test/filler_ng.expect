module uut_rng_x(input wire [1:0] clock_reset, input wire [31:0] i, output reg [31:0] o);
   wire  clock;
   wire  reset;
   assign clock = clock_reset[0];
   assign reset = clock_reset[1];
   initial begin
      o = 32'b01100010010110010010110001100010;
   end
   always @(posedge clock) begin
      if (reset) begin
         o <= 32'b01100010010110010010110001100010;
      end else begin
         o <= i;
      end
   end
endmodule
